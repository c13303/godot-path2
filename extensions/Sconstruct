import os, glob
from SCons.Script import Environment, Dir

root = Dir('.').abspath
godot_cpp_path = os.path.abspath(os.path.join(root, "../../godot-cpp"))
godot_cpp_bin  = os.path.join(godot_cpp_path, "bin")

env = Environment(tools=["default", "msvc"])

env.Append(CPPPATH=[
    os.path.join(godot_cpp_path, "include"),
    os.path.join(godot_cpp_path, "gen", "include"),
    os.path.join(godot_cpp_path, "gdextension"),
])

env.Append(LIBPATH=[godot_cpp_bin])
env.Append(LIBS=["libgodot-cpp.windows.template_release.x86_64"])

env.Append(CXXFLAGS=["/std:c++17"])
env.Append(CPPDEFINES=["NOMINMAX"])

sources = glob.glob("flowfield/*.cpp")

target_dir = os.path.join(root, "flowfield", "bin")
os.makedirs(target_dir, exist_ok=True)

env.SharedLibrary(
    target=os.path.join(target_dir, "flowfield"),
    source=sources
)
