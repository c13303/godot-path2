import glob
import os

from SCons.Script import ARGUMENTS, Dir, Environment


def norm(path):
    return path.replace("\\", "/")


root = Dir(".").abspath
godot_cpp_path = os.path.abspath(os.path.join(root, "../../godot-cpp"))
godot_cpp_bin = os.path.join(godot_cpp_path, "bin")

target = ARGUMENTS.get("target", "template_debug")
use_mingw = ARGUMENTS.get("use_mingw", "yes")

if use_mingw == "yes":
    env = Environment(tools=["mingw"], CXX="/mingw64/bin/g++", CC="/mingw64/bin/gcc")
    env.Append(CXXFLAGS=["-std=c++17"])
else:
    env = Environment(tools=["default", "msvc"])
    env.Append(CXXFLAGS=["/std:c++17", "/Zc:__cplusplus"])

env.Append(
    CPPPATH=[
        norm(os.path.join(godot_cpp_path, "include")),
        norm(os.path.join(godot_cpp_path, "gen", "include")),
        norm(os.path.join(godot_cpp_path, "gdextension")),
        norm(root),
    ],
    LIBPATH=[norm(godot_cpp_bin)],
    CPPDEFINES=["NOMINMAX"],
)

if target == "template_debug":
    env.Append(LIBS=["godot-cpp.windows.template_debug.x86_64"])
else:
    env.Append(LIBS=["godot-cpp.windows.template_release.x86_64"])

generic_sources = [
    source
    for source in glob.glob("CPathLib/**/*.cpp", recursive=True)
    if "/tests/" not in norm(source)
]

cpathlib_bin = norm(os.path.join(root, "CPathLib", "bin"))
os.makedirs(cpathlib_bin, exist_ok=True)
env.SharedLibrary(
    target=os.path.join(cpathlib_bin, "cpathlib"),
    source=generic_sources,
)

# The host module preserves the project's established native API while its callers
# are migrated. It owns all gameplay-facing code and only consumes the portable
# CPathLib implementation; CPathLib never depends on this module.
portable_sources = [
    source
    for source in generic_sources
    if "/godot/" not in norm(source) and not source.endswith("CPathLib/register_types.cpp")
]
host_sources = [
    source
    for source in glob.glob("rabbit_game_native/**/*.cpp", recursive=True)
    if "/tests/" not in norm(source)
]

host_bin = norm(os.path.join(root, "rabbit_game_native", "bin"))
os.makedirs(host_bin, exist_ok=True)
env.SharedLibrary(
    target=os.path.join(host_bin, "rabbit_game_native"),
    source=portable_sources + host_sources,
)
