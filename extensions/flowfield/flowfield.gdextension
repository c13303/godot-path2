[configuration]
entry_symbol = "flowfield_library_init"
compatibility_minimum = "4.5"

[libraries]
windows.debug.x86_64 = "res://extensions/flowfield/bin/flowfield.dll"
windows.release.x86_64 = "res://extensions/flowfield/bin/flowfield.dll"

[dependencies]
windows.debug.x86_64 = {
"res://extensions/flowfield/bin/libgcc_s_seh-1.dll" : "",
"res://extensions/flowfield/bin/libstdc++-6.dll" : "",
"res://extensions/flowfield/bin/libwinpthread-1.dll" : ""
}
windows.release.x86_64 = {
"res://extensions/flowfield/bin/libgcc_s_seh-1.dll" : "",
"res://extensions/flowfield/bin/libstdc++-6.dll" : "",
"res://extensions/flowfield/bin/libwinpthread-1.dll" : ""
}
