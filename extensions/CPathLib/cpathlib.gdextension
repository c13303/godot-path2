[configuration]
entry_symbol = "cpathlib_library_init"
compatibility_minimum = "4.5"

[libraries]
windows.debug.x86_64 = "bin/cpathlib.dll"
windows.release.x86_64 = "bin/cpathlib.dll"

[dependencies]
windows.debug.x86_64 = {
"bin/libgcc_s_seh-1.dll" : "",
"bin/libstdc++-6.dll" : "",
"bin/libwinpthread-1.dll" : ""
}
windows.release.x86_64 = {
"bin/libgcc_s_seh-1.dll" : "",
"bin/libstdc++-6.dll" : "",
"bin/libwinpthread-1.dll" : ""
}
