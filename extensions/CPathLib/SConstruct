import glob
import os

from SCons.Script import ARGUMENTS, Alias, Default, Dir, Environment


def norm(path):
    return path.replace("\\", "/")


root = Dir(".").abspath
godot_cpp_path = os.path.abspath(ARGUMENTS.get("godot_cpp_dir", "../godot-cpp"))
target = ARGUMENTS.get("target", "template_debug")
use_mingw = ARGUMENTS.get("use_mingw", "yes")


def find_mingw_tool(name):
    """Locate a MinGW tool without assuming an MSYS2 shell.

    `/mingw64/...` only resolves inside an MSYS2 shell, so hardcoding it breaks the
    build from Git Bash, cmd, or CI. Prefer an explicit `mingw_bin=` argument, then
    the usual install locations, and fall back to PATH.
    """
    explicit = ARGUMENTS.get("mingw_bin", "")
    candidates = []
    if explicit:
        candidates.append(os.path.join(explicit, name + ".exe"))
        candidates.append(os.path.join(explicit, name))
    candidates += [
        "/mingw64/bin/" + name,
        "C:/msys64/mingw64/bin/" + name + ".exe",
        "C:/mingw64/bin/" + name + ".exe",
    ]
    for candidate in candidates:
        if os.path.exists(candidate):
            return norm(candidate)
    return name


def make_environment():
    if use_mingw == "yes":
        compiler = find_mingw_tool("g++")
        environment = Environment(
            tools=["mingw"],
            CXX=compiler,
            CC=find_mingw_tool("gcc"))
        environment.Append(CXXFLAGS=["-std=c++17"])
        # g++.exe loads its runtime DLLs from its own directory. SCons runs commands
        # with a minimal environment, so without this the compiler starts and dies
        # with no diagnostic unless the caller's shell already had it on PATH.
        compiler_dir = os.path.dirname(compiler)
        if compiler_dir:
            environment["ENV"]["PATH"] = (
                norm(compiler_dir) + os.pathsep + environment["ENV"].get("PATH", ""))
    else:
        environment = Environment(tools=["default", "msvc"])
        environment.Append(CXXFLAGS=["/std:c++17", "/Zc:__cplusplus"])
    return environment


env = make_environment()
env.Append(
    CPPPATH=[
        norm(os.path.join(godot_cpp_path, "include")),
        norm(os.path.join(godot_cpp_path, "gen", "include")),
        norm(os.path.join(godot_cpp_path, "gdextension")),
        norm(root),
    ],
    LIBPATH=[norm(os.path.join(godot_cpp_path, "bin"))],
    CPPDEFINES=["NOMINMAX"],
)

if target == "template_debug":
    env.Append(LIBS=["godot-cpp.windows.template_debug.x86_64"])
else:
    env.Append(LIBS=["godot-cpp.windows.template_release.x86_64"])

all_sources = [norm(source) for source in glob.glob("**/*.cpp", recursive=True)]
library_sources = [
    source for source in all_sources if not source.startswith("tests/")]

output_dir = norm(os.path.join(root, "bin"))
os.makedirs(output_dir, exist_ok=True)
library = env.SharedLibrary(
    target=os.path.join(output_dir, "cpathlib"), source=library_sources)

# The simulation modules never include godot_cpp, so the unit tests link against
# them directly and need no engine, no editor and no GDExtension entry point. Only
# godot/ is excluded: that is the binding layer.
portable_sources = [
    source
    for source in library_sources
    if not source.startswith("godot/") and source != "register_types.cpp"
]

# Each object is given an explicit path under build/tests so the test build and the
# library build never claim the same object file with two different environments.
# Deliberately not VariantDir: its variant directory would sit inside its own source
# directory here, which SCons handles badly.
test_env = make_environment()
test_env.Append(CPPPATH=[norm(root)], CPPDEFINES=["NOMINMAX"])


def test_object(source):
    target = "build/tests/" + source[:-len(".cpp")] + ".o"
    # g++ will not create the output directory, and SCons does not do it for an
    # explicitly named Object target, so make it here.
    os.makedirs(os.path.dirname(os.path.join(root, target)), exist_ok=True)
    return test_env.Object(target=target, source=source)


test_objects = [test_object(source) for source in portable_sources]

test_programs = []
for test_source in sorted(norm(path) for path in glob.glob("tests/test_*.cpp")):
    name = os.path.splitext(os.path.basename(test_source))[0]
    test_programs.append(test_env.Program(
        target=os.path.join(output_dir, name),
        source=[test_object(test_source)] + test_objects,
    ))

Alias("tests", test_programs)
# A bare `scons` builds only the library; `scons tests` adds the executables.
Default(library)
